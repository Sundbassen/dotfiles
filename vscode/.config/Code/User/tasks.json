                "${file}",
                "${lineNumber}",
                "1",
                "${workspaceFolder}"
            ],
            "presentation": {
                "reveal": "never",
                "panel": "dedicated",
                "clear": true,
                "close": true
            },
            "problemMatcher": []
        }
    ]
}