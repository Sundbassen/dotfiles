" Enable syntax highlighting
syntax on

" Enable filetype detection, plugins, and indentation
filetype plugin indent on

" Show line numbers
set number

" Highlight the current line
set cursorline

" Set the style for the current line highlight (underline)
highlight CursorLine cterm=underline term=underline

" Enable better search highlighting
set hlsearch
set incsearch

" Enable mouse support (optional)
set mouse=a

" Set a more readable color scheme (optional)
colorscheme desert
