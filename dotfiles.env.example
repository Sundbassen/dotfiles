# Machine-local secrets and paths, sourced by .bashrc.
# Copy to ~/.config/dotfiles.env and fill in. Never commit the real file.

# bin/vpn: WireGuard config (holds the private key, keep it outside the repo)
export WG_CONF="$HOME/wireguard/CHANGE-ME.conf"

# Files that are not env vars but must be placed by hand:
#   ~/.ssh/id_ed25519 (+ .pub)   loaded by .bashrc into the agent
#   $WG_CONF                     used by bin/vpn
#   ~/.bashrc.local              optional, for work-specific shell setup
