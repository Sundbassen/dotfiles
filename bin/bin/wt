#!/usr/bin/env bash
# wt: git worktrees around a bare repo, one directory per branch.
#
#   <parent>/.<repo>/     bare repo (any bare dir is detected)
#   <parent>/main/        worktree of the default branch
#   <parent>/<branch>/    one worktree per branch, "/" in names becomes "-"
#   <parent>/env/         untracked files, mirrored as symlinks into every new worktree
#   <parent>/.wt-hook     optional, sourced after a worktree is created
#
# On --clone / --add / --switch the last line printed is the worktree path,
# so a shell wrapper can cd into it.
#
# Stacks are delegated to the gh-stack extension (gh extension install github/gh-stack),
# which keeps its metadata in <bare repo>/gh-stack, shared by all worktrees.
set -euo pipefail

usage() {
    cat <<EOF
Usage: wt <command> [args]

Commands:
  --clone <url> [dir]     Bare-clone a repo into dir (default: repo name) and add the default-branch worktree
  --add <branch>          Create a new branch (from the current one) and a worktree for it;
                          from a feature branch it is also added to a gh stack
  --switch <branch>       Create a worktree for an existing local or origin branch
  --delete <branch>       Remove the worktree for a branch
  --prune                 Remove every worktree except the default branch, then delete merged branches
                          and their local gh stack metadata
  --link                  (Re)link env/ files into the current worktree
  --push                  Push the current branch (or pick one with fzf) to origin with -u;
                          a branch in a stack pushes the whole stack (force-with-lease)
  --restack               Rebase every stack branch above the current one, then push the stack

Options:
  -f                      Force (--push, --delete)
  -h, --help              Show this help

Per-repo setup, next to the bare repo:
  env/                    files here are symlinked into new worktrees at the same relative path
  .wt-hook                sourced after creation; sees WORKTREE_PATH, PARENT_DIR, SOURCE_WORKTREE, GIT_DIR
EOF
}

COMMAND="" BRANCH="" FORCE="" CLONE_URL="" CLONE_DIR=""
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help) usage; exit 0 ;;
        --clone) COMMAND=$1; CLONE_URL=${2:?--clone needs a url}; CLONE_DIR=${3:-}; shift 2; [[ -n "$CLONE_DIR" ]] && shift ;;
        --add|--switch|--delete) COMMAND=$1; BRANCH=${2:?$1 needs a branch name}; shift 2 ;;
        --prune|--push|--link|--restack) COMMAND=$1; shift ;;
        -f) FORCE="--force"; shift ;;
        *) echo "Unknown option: $1 (see -h)" >&2; exit 1 ;;
    esac
done
[[ -n "$COMMAND" ]] || { usage >&2; exit 1; }

is_bare() { [[ "$(git -C "$1" rev-parse --is-bare-repository 2>/dev/null)" == true ]]; }

find_bare_in() {
    local d
    for d in "$1"/.[!.]* "$1"/*; do
        [[ -d "$d" ]] && is_bare "$d" && { echo "$d"; return 0; }
    done
    return 1
}

default_branch() {
    local ref
    if ref="$(git -C "$GIT_DIR" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)"; then
        echo "${ref#origin/}"
    else
        echo main
    fi
}

link_env() {
    local env_root="$PARENT_DIR/env" f rel dst
    [[ -d "$env_root" ]] || return 0
    while IFS= read -r -d '' f; do
        rel="${f#"$env_root"/}"
        dst="$WORKTREE_PATH/$rel"
        if [[ -e "$dst" && ! -L "$dst" ]]; then
            echo "env: $rel already exists in worktree, left alone" >&2
            continue
        fi
        mkdir -p "$(dirname "$dst")"
        ln -sfn "$(realpath --relative-to="$(dirname "$dst")" "$f")" "$dst"
        echo "env: linked $rel"
    done < <(find "$env_root" -type f -print0 | sort -z)
}

run_hook() {
    [[ -f "$PARENT_DIR/.wt-hook" ]] || return 0
    # shellcheck source=/dev/null
    . "$PARENT_DIR/.wt-hook"
}

after_create() {
    link_env
    run_hook
    echo "✓ Worktree created at $WORKTREE_PATH"
    echo "$WORKTREE_PATH"
}

if [[ "$COMMAND" == "--clone" ]]; then
    name="$(basename "$CLONE_URL" .git)"
    PARENT_DIR="$(realpath -m "${CLONE_DIR:-$name}")"
    GIT_DIR="$PARENT_DIR/.$name"
    [[ -e "$GIT_DIR" ]] && { echo "Error: $GIT_DIR already exists" >&2; exit 1; }

    mkdir -p "$PARENT_DIR/env"
    git init --quiet --bare "$GIT_DIR"
    git -C "$GIT_DIR" remote add origin "$CLONE_URL"
    git -C "$GIT_DIR" config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
    echo "Fetching $CLONE_URL..."
    git -C "$GIT_DIR" fetch --quiet origin
    git -C "$GIT_DIR" remote set-head origin --auto >/dev/null

    DEFAULT="$(default_branch)"
    WORKTREE_PATH="$PARENT_DIR/${DEFAULT//\//-}"
    git -C "$GIT_DIR" worktree add --quiet --track -b "$DEFAULT" "$WORKTREE_PATH" "origin/$DEFAULT"
    SOURCE_WORKTREE="$WORKTREE_PATH"
    after_create
    exit 0
fi

# Locate the bare repo: from inside a worktree, or from the parent directory.
if common="$(git rev-parse --git-common-dir 2>/dev/null)"; then
    GIT_DIR="$(cd "$common" && pwd)"
    if [[ "$(basename "$GIT_DIR")" == .git ]]; then
        echo "Error: this is a normal clone, wt needs the bare layout (see wt --clone)" >&2
        exit 1
    fi
elif ! GIT_DIR="$(find_bare_in "$PWD")"; then
    echo "Error: not inside a worktree and no bare repo found in $PWD" >&2
    exit 1
fi
PARENT_DIR="$(dirname "$GIT_DIR")"
DEFAULT="$(default_branch)"
MAIN_WORKTREE="$PARENT_DIR/${DEFAULT//\//-}"
WORKTREE_PATH="$PARENT_DIR/${BRANCH//\//-}"

if [[ -d "$MAIN_WORKTREE" ]]; then
    SOURCE_WORKTREE="$MAIN_WORKTREE"
else
    SOURCE_WORKTREE="$(git rev-parse --show-toplevel 2>/dev/null || true)"
fi

current_branch() {
    local b
    b="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" && [[ "$b" != HEAD ]] && echo "$b"
}

worktree_of() {
    git -C "$GIT_DIR" worktree list --porcelain |
        awk -v ref="branch refs/heads/$1" '/^worktree /{p=substr($0, 10)} $0 == ref {print p; exit}'
}

# --- gh stack ---------------------------------------------------------------

# Sets STACK to `gh stack view --json` for the branch checked out in $1, or to ""
# when that branch is not in a stack (exit 2). Anything else (gh-stack missing,
# broken metadata) prints gh's error and stops wt.
load_stack() {
    local rc=0 err
    err="$(mktemp)"
    STACK="$(cd "$1" && gh stack view --json 2>"$err")" || rc=$?
    if (( rc != 0 && rc != 2 )); then
        cat "$err" >&2
        rm -f "$err"
        echo "Error: 'gh stack view' failed in $1" >&2
        exit "$rc"
    fi
    rm -f "$err"
    (( rc == 0 )) || STACK=""
}

# Whether origin is on a host gh is logged in to (github.com or GHES). gh stack
# push/sync/submit need the GitHub API; elsewhere wt pushes the stack with git.
on_github() {
    if [[ -z "${ON_GITHUB:-}" ]]; then
        local host
        host="$(git -C "$GIT_DIR" remote get-url origin 2>/dev/null || true)"
        host="${host#*://}"    # https://host/o/r, ssh://git@host:22/o/r
        host="${host#*@}"      # git@host:o/r
        host="${host%%[:/]*}"
        ON_GITHUB=no
        [[ -n "$host" ]] && gh auth status --hostname "$host" >/dev/null 2>&1 && ON_GITHUB=yes
    fi
    [[ "$ON_GITHUB" == yes ]]
}

# gh stack push does not set upstreams; keep wt's -u behaviour.
set_upstreams() {
    local b
    for b in "$@"; do
        git -C "$GIT_DIR" config "branch.$b.remote" >/dev/null && continue
        git -C "$GIT_DIR" branch --quiet --set-upstream-to="origin/$b" "$b" ||
            echo "⚠ could not set upstream for $b" >&2
    done
}

# Run after `worktree add` for a branch created from a non-default BASE, with
# STACK loaded for BASE. Failures only warn: the worktree already exists.
stack_add() {
    if ! stack_has "$BASE"; then
        echo "Starting stack: $DEFAULT ← $BASE ← $BRANCH"
        gh stack init --base "$DEFAULT" "$BASE" "$BRANCH" || echo "⚠ gh stack init failed, '$BRANCH' is not in a stack"
    elif [[ "$(jq -r '.branches[-1].name' <<<"$STACK")" == "$BASE" ]]; then
        echo "Adding '$BRANCH' to the top of the stack"
        gh stack add "$BRANCH" || echo "⚠ gh stack add failed, '$BRANCH' is not in the stack"
    else
        echo "'$BASE' is in the middle of a stack, so '$BRANCH' is left out of it:"
        gh stack add "$BRANCH" || true
    fi
}

# Push every active branch of the stack loaded in STACK, run from worktree $1.
stack_push() {
    local branches=()
    mapfile -t branches < <(jq -r '.branches[] | select((.isMerged or .isQueued) | not) | .name' <<<"$STACK")
    (( ${#branches[@]} )) || { echo "Nothing to push, every branch in the stack is merged or queued"; return 0; }
    [[ -n "$FORCE" ]] && echo "note: -f ignored, a stack is pushed with --force-with-lease" >&2
    echo "Pushing stack: ${branches[*]}"
    if on_github; then
        (cd "$1" && gh stack push)
    else
        git -C "$GIT_DIR" push --atomic --force-with-lease origin "${branches[@]}"
    fi
    set_upstreams "${branches[@]}"
    echo "✓ Pushed stack"
}

# STACK holds a stack that contains branch $1 (and $1 is not just its trunk).
stack_has() {
    [[ -n "$STACK" ]] && jq -e --arg b "$1" 'any(.branches[]; .name == $b)' <<<"$STACK" >/dev/null
}

case $COMMAND in
    --add)
        BASE="$(current_branch || echo "$DEFAULT")"
        # Look up the stack before creating anything, so a missing gh-stack fails cleanly.
        [[ "$BASE" == "$DEFAULT" ]] || load_stack "$PWD"
        echo "Creating branch '$BRANCH' from '$BASE'"
        git -C "$GIT_DIR" worktree add --quiet "$WORKTREE_PATH" -b "$BRANCH" "$BASE"
        # The branch must exist before gh stack adopts it: `gh stack add` on a new
        # name would create it by switching this worktree. Keep stdout's last line
        # for the worktree path.
        [[ "$BASE" == "$DEFAULT" ]] || stack_add >&2
        after_create
        ;;

    --switch)
        git -C "$GIT_DIR" fetch --quiet origin
        if git -C "$GIT_DIR" show-ref --verify --quiet "refs/heads/$BRANCH"; then
            git -C "$GIT_DIR" worktree add --quiet "$WORKTREE_PATH" "$BRANCH"
        elif git -C "$GIT_DIR" show-ref --verify --quiet "refs/remotes/origin/$BRANCH"; then
            git -C "$GIT_DIR" worktree add --quiet --track -b "$BRANCH" "$WORKTREE_PATH" "origin/$BRANCH"
        else
            echo "Error: branch '$BRANCH' not found locally or on origin" >&2
            exit 1
        fi
        after_create
        ;;

    --delete)
        git -C "$GIT_DIR" worktree remove ${FORCE} "$WORKTREE_PATH"
        echo "✓ Worktree removed: $WORKTREE_PATH"
        ;;

    --prune)
        if [[ -e "$GIT_DIR/gh-stack-rebase-state" ]]; then
            echo "Error: a gh stack rebase is in progress; finish it with 'gh stack rebase --continue' or '--abort' first" >&2
            exit 1
        fi
        echo "Removing all worktrees except $MAIN_WORKTREE..."
        while IFS= read -r path; do
            [[ "$path" == "$MAIN_WORKTREE" || "$path" == "$GIT_DIR" ]] && continue
            echo "  removing $(basename "$path")"
            git -C "$GIT_DIR" worktree remove --force "$path"
        done < <(git -C "$GIT_DIR" worktree list --porcelain | awk '/^worktree /{print substr($0, 10)}')
        git -C "$GIT_DIR" worktree prune

        echo "Deleting branches (except $DEFAULT)..."
        kept=0
        while IFS= read -r b; do
            [[ "$b" == "$DEFAULT" ]] && continue
            if git -C "$GIT_DIR" branch -D "$b" >/dev/null 2>&1; then
                echo "  deleted $b"
            else
                echo "  kept $b"
                kept=1
            fi
        done < <(git -C "$GIT_DIR" branch --format='%(refname:short)')
        if [[ -e "$GIT_DIR/gh-stack" ]]; then
            if (( kept )); then
                echo "⚠ some branches were kept, so gh stack metadata was left alone (see 'gh stack view')" >&2
            else
                rm -f "$GIT_DIR/gh-stack"
                echo "  removed gh stack metadata"
            fi
        fi
        echo "✓ Prune complete"
        ;;

    --link)
        WORKTREE_PATH="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "Error: run --link from inside a worktree" >&2; exit 1; }
        link_env
        ;;

    --push)
        if ! PUSH_BRANCH="$(current_branch)"; then
            PUSH_BRANCH="$(git -C "$GIT_DIR" branch --format='%(refname:short)' | fzf --height=20% --reverse)" || true
            [[ -n "$PUSH_BRANCH" ]] || { echo "No branch selected" >&2; exit 1; }
        fi
        # gh stack works on the checked-out branch, so look the stack up in its worktree.
        STACK="" PUSH_WORKTREE="$(worktree_of "$PUSH_BRANCH")"
        if [[ "$PUSH_BRANCH" != "$DEFAULT" && -n "$PUSH_WORKTREE" ]]; then
            load_stack "$PUSH_WORKTREE"
        fi
        if stack_has "$PUSH_BRANCH"; then
            stack_push "$PUSH_WORKTREE"
        else
            echo "Pushing $PUSH_BRANCH"
            git -C "$GIT_DIR" push -u ${FORCE} origin "$PUSH_BRANCH"
            echo "✓ Pushed $PUSH_BRANCH"
        fi
        ;;

    --restack)
        WORKTREE_PATH="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "Error: run --restack from inside a worktree" >&2; exit 1; }
        RESTACK_BRANCH="$(current_branch)" || { echo "Error: no branch checked out" >&2; exit 1; }
        load_stack "$WORKTREE_PATH"
        stack_has "$RESTACK_BRANCH" || { echo "Error: '$RESTACK_BRANCH' is not in a gh stack" >&2; exit 1; }
        rc=0
        (cd "$WORKTREE_PATH" && gh stack rebase --upstack --no-trunk) || rc=$?
        if (( rc == 3 )); then
            echo "Resolve the conflict in the worktree gh named, run 'gh stack rebase --continue', then 'wt --push'" >&2
            exit 3
        fi
        (( rc == 0 )) || exit "$rc"
        load_stack "$WORKTREE_PATH"   # merged/queued state may have changed
        stack_push "$WORKTREE_PATH"
        ;;
esac
